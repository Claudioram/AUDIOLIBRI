# ── Auth ──────────────────────────────────────────────────────────────────────
APP_PASSWORD=changeme
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_EXPIRY_HOURS=720

# ── MiniMax API ───────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_DEFAULT_VOICE_ID=

# ── Reference voice for initial cloning ──────────────────────────────────────
REFERENCE_VOICE_PATH=/app/storage/reference/narrator_it.wav

# ── Storage paths ─────────────────────────────────────────────────────────────
STORAGE_PATH=/app/storage
DATA_PATH=/app/data

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Domain / Traefik ──────────────────────────────────────────────────────────
DOMAIN=audiolibri.example.com
ACME_EMAIL=admin@example.com

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=200
MAX_CHAPTER_CHARS=50000
